{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cognitive-emergence/ART/corpus/schema/art-case.schema.json",
  "title": "ART Falsification Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","version","title","domain","case_type","status","operational_setting","actors","trust_boundary","initial_state","intended_transition","constraints","candidate_under_attack","attack","success_criteria_for_attack","evidence_requirements","verdict"],
  "properties": {
    "id": {"type":"string","pattern":"^ART-CASE-[0-9]{4}$"},
    "version": {"const":"0.1"},
    "title": {"type":"string","minLength":5},
    "domain": {"type":"string","minLength":2},
    "case_type": {"enum":["synthetic-adversarial","real-system","incident","comparative-design"]},
    "status": {"enum":["OPEN","EVALUATED"]},
    "operational_setting": {"type":"string","minLength":20},
    "actors": {"type":"array","minItems":1,"items":{"type":"string"}},
    "trust_boundary": {"type":"string","minLength":10},
    "initial_state": {"type":"string","minLength":5},
    "intended_transition": {"type":"string","minLength":5},
    "constraints": {"type":"array","items":{"type":"string"}},
    "candidate_under_attack": {"enum":["Target","Baseline","Constraint","BoundedAuthority","Judgment","Delegation","Termination","Action","Evidence","Verification","TemporalOrdering","ActorBinding","CausalAttribution","Responsibility","Settlement","JDTVGrammar"]},
    "attack": {"type":"object","additionalProperties":false,"required":["method","removed_or_replaced","allowed_substitutes","procedure"],"properties":{"method":{"enum":["deletion","substitution","hidden-reconstruction","cross-domain","alternative-grammar"]},"removed_or_replaced":{"type":"string"},"allowed_substitutes":{"type":"array","items":{"type":"string"}},"procedure":{"type":"string","minLength":20}}},
    "success_criteria_for_attack": {"type":"string","minLength":20},
    "evidence_requirements": {"type":"array","minItems":1,"items":{"type":"string"}},
    "observations": {"type":"array","items":{"type":"string"}},
    "information_loss": {"type":"array","items":{"type":"string"}},
    "verdict": {"type":"object","additionalProperties":false,"required":["result","rationale"],"properties":{"result":{"enum":["SURVIVES","WEAKENED","FALSIFIED","INDETERMINATE"]},"rationale":{"type":"string"}}},
    "sources": {"type":"array","items":{"type":"string"}},
    "created_at": {"type":"string","format":"date"},
    "last_evaluated_at": {"type":["string","null"],"format":"date"}
  }
}
